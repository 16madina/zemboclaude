{
  "expo": {
    "name": "Zembo",
    "slug": "madinadiallo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zembo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050403",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zembo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zembo a besoin de tes photos et vidéos pour que tu puisses les publier."
        }
      ],
      "expo-audio",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Zembo utilise ta caméra pour te montrer en direct quand tu montes sur scène.",
          "microphonePermission": "Zembo utilise ton micro pour que tu parles en direct pendant les lives."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Zembo utilise ta caméra pour filmer tes vidéos, tes Duos et pour te montrer en direct.",
          "microphonePermission": "Zembo utilise ton micro pour enregistrer le son de tes vidéos et parler en direct.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class livekit.org.webrtc.** { *; }\n-keep class livekit.org.jni_zero.** { *; }\n-dontwarn livekit.org.jni_zero.**\n-dontwarn livekit.org.webrtc.**"
          }
        }
      ]
    ],
    "backgroundColor": "#050403",
    "splash": {
      "image": "./assets/splash/zembo-splash-first.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "owner": "missdee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7417e5cc-9668-4402-8bc3-23b72bee1b5a"
    },
    "extra": {
      "eas": {
        "projectId": "7417e5cc-9668-4402-8bc3-23b72bee1b5a"
      }
    }
  }
}
