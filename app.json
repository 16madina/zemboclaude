{
  "expo": {
    "name": "Zembo",
    "slug": "madinadiallo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zembo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zembo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-image",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zembo a besoin de tes photos pour ton profil World Room."
        }
      ],
      "expo-audio"
    ],
    "backgroundColor": "#0A0806",
    "splash": {
      "backgroundColor": "#0A0806"
    },
    "owner": "missdee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7417e5cc-9668-4402-8bc3-23b72bee1b5a"
    },
    "extra": {
      "eas": {
        "projectId": "7417e5cc-9668-4402-8bc3-23b72bee1b5a"
      }
    }
  }
}
