rules_version = '2';

// Règles de sécurité Firestore du projet « Zembo Claude ».
// Principe : chacun ne peut créer, modifier ou supprimer que ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // petit document « qui → quoi » : seulement la date, posée par le serveur
    function stampOnly() {
      return request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    function postExists(id) { return exists(/databases/$(database)/documents/posts/$(id)); }

    // Fiche du compte Zembo
    // (contient email et téléphone : lisible seulement par soi-même ; la partie publique est dans /profiles)
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasAll(['nom', 'prenom', 'pseudo', 'email'])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() >= 3
        && request.resource.data.pseudo.size() <= 20;
      // le pseudo ne peut pas être changé directement (il est réservé dans /usernames)
      allow update: if isMe(uid) && request.resource.data.pseudo == resource.data.pseudo;
      allow delete: if isMe(uid);

      // users/{uid}/followers/{fid} : fid suit uid (posé par fid)
      match /followers/{fid} {
        allow read: if true;
        allow create: if isMe(fid) && fid != uid && stampOnly();
        allow delete: if isMe(fid);
      }
      // users/{uid}/following/{tid} : uid suit tid (posé par uid)
      match /following/{tid} {
        allow read: if true;
        allow create: if isMe(uid) && tid != uid && stampOnly();
        allow delete: if isMe(uid);
      }
      // mes j'aime et mes enregistrements (privés)
      match /likes/{pid} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && stampOnly();
      }
      match /saved/{pid} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && stampOnly() && postExists(pid);
      }
    }

    // Fiche publique d'un membre : compteurs (abonnés, abonnements, j'aime reçus), tenue par le serveur
    match /profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Hashtags : nombre de publications par hashtag, tenu par le serveur
    match /hashtags/{tag} {
      allow read: if true;
      allow write: if false;
    }

    // Réservation des pseudos Zembo (un pseudo = un compte).
    // Lecture ouverte : l'inscription vérifie si le pseudo est libre avant de créer le compte.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Profil Zembo Meet : visible par les membres connectés une fois terminé
    match /worldProfiles/{uid} {
      allow read: if isMe(uid) || (signedIn() && resource.data.completed == true);
      allow create, update: if isMe(uid);
      allow delete: if isMe(uid);
    }

    // Réservation des pseudos Zembo Meet
    match /worldUsernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Lives (vidéo LiveKit) : le document est créé par le serveur (fonction livekitToken).
    // Tout membre connecté peut le lire ; seul l'hôte peut changer qui est sur scène.
    // La salle est nommée format-uid de l'hôte : seul lui peut l'ouvrir.
    // stage : un uid par place ('' = libre) ; names : pseudos ; muted : micros coupés par l'hôte ;
    // perf : le passage en cours (Mic d'Or Thérapie).
    match /lives/{room} {
      function stageOk() {
        return request.resource.data.stage is list && request.resource.data.stage.size() <= 9;
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && room.split('-').size() == 2 && room.split('-')[1] == request.auth.uid
        && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'stage', 'names', 'muted', 'capacity', 'perf', 'queue', 'since', 'createdAt'])
        && stageOk();
      allow update: if signedIn() && (
        // l'hôte
        (request.auth.uid == resource.data.host
          && request.resource.data.host == resource.data.host
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'names', 'muted', 'capacity', 'perf', 'queue', 'since'])
          && stageOk())
        // une personne sur scène qui redescend d'elle-même (sans toucher aux autres places)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage'])
          && request.auth.uid in resource.data.stage
          && !(request.auth.uid in request.resource.data.stage)
          && request.resource.data.stage.size() == resource.data.stage.size()
          && request.resource.data.stage.removeAll(['']) == resource.data.stage.removeAll([request.auth.uid, '']))
      );
      allow delete: if false;

      // demandes pour monter sur scène : chacun la sienne ; l'hôte les voit et les retire
      match /requests/{uid} {
        allow read: if isMe(uid) || (signedIn() && get(/databases/$(database)/documents/lives/$(room)).data.host == request.auth.uid);
        allow create: if isMe(uid)
          && request.resource.data.keys().hasOnly(['pseudo', 'createdAt', 'slot'])
          && (!('slot' in request.resource.data) || request.resource.data.slot is map)
          && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 40
          && request.resource.data.createdAt == request.time;
        allow delete: if isMe(uid) || (signedIn() && get(/databases/$(database)/documents/lives/$(room)).data.host == request.auth.uid);
        allow update: if false;
      }
      // jeux à plusieurs : l'état de la partie, publié par l'hôte (l'arbitre), lisible par tous
      match /game/{d} {
        allow read: if signedIn();
        allow write: if signedIn() && get(/databases/$(database)/documents/lives/$(room)).data.host == request.auth.uid;
      }
      // l'action de chaque joueur (sa saisie, sa réponse), lue seulement par l'hôte
      match /moves/{uid} {
        allow read: if isMe(uid) || (signedIn() && get(/databases/$(database)/documents/lives/$(room)).data.host == request.auth.uid);
        allow create, update: if isMe(uid) && request.resource.data.size() <= 12;
        allow delete: if false;
      }
      // mains levées (« demander à parler ») : chacun la sienne ; l'hôte peut les baisser
      match /hands/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid) && stampOnly();
        allow delete: if isMe(uid) || (signedIn() && get(/databases/$(database)/documents/lives/$(room)).data.host == request.auth.uid);
        allow update: if false;
      }
    }

    // Lives en cours, affichés sur l'accueil (salle = format-uid de l'hôte).
    // L'hôte crée, signe (aliveAt) et retire son live ; le nombre de spectateurs est tenu par le serveur.
    function liveFields() {
      return request.resource.data.keys().hasOnly(['uid', 'format', 'title', 'pseudo', 'name', 'startedAt', 'aliveAt', 'viewers'])
        && request.resource.data.format in ['table', 'slam', 'openmic', 'lettres', 'motdor']
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.aliveAt is timestamp && request.resource.data.aliveAt <= request.time;
    }
    match /onAir/{room} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && room == request.resource.data.format + '-' + request.auth.uid
        && liveFields()
        && !('viewers' in request.resource.data);
      allow update: if isMe(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.format == resource.data.format
        && liveFields()
        && (!('viewers' in request.resource.data) || request.resource.data.viewers == resource.data.get('viewers', 0));
      allow delete: if isMe(resource.data.uid);

      // chat du live : chacun écrit les siens ; l'auteur ou l'hôte peut supprimer un message
      match /chat/{cid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/onAir/$(room));
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/onAir/$(room)).data.uid == request.auth.uid);
        allow update: if false;
      }
      // spectateurs présents
      match /viewers/{uid} {
        allow read: if true;
        allow create: if isMe(uid) && stampOnly() && exists(/databases/$(database)/documents/onAir/$(room));
        allow delete: if isMe(uid);
      }
    }

    // Publications (vidéos et photos) : visibles par tous, chacun ne publie et ne supprime que les siennes.
    // Les compteurs (j'aime, commentaires…) partent de 0 ; l'auteur peut seulement modifier sa légende.
    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['video', 'photo']
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://firebasestorage.googleapis.com/.*')
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300
        && request.resource.data.hashtags is list
        && request.resource.data.hashtags.size() <= 10
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.shares == 0
        && request.resource.data.saves == 0;
      allow update: if isMe(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'hashtags'])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300;
      allow delete: if isMe(resource.data.uid);

      // posts/{id}/likes/{uid} : uid aime la publication
      match /likes/{uid} {
        allow read: if true;
        allow create: if isMe(uid) && stampOnly() && postExists(id);
        allow delete: if isMe(uid);
      }
      // commentaires : chacun écrit les siens ; l'auteur du commentaire ou de la publication peut le supprimer
      match /comments/{cid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && postExists(id);
        allow delete: if signedIn()
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/posts/$(id)).data.uid == request.auth.uid);
        allow update: if false;
      }
    }

    // Tout le reste est fermé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
